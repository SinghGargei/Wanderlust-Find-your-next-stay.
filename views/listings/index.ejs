<% layout("/layouts/boilerplate") %>

<h3>All Listings</h3>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
  <% for(let listing of allListing) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
      <div class="card col listing-card h-100">
        <img 
          src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?v=1') %>" 
          class="card-img-top" 
          alt="listing_image" 
          style="height: 20rem; object-fit: cover;"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1625505826533-5c80aca7d157?v=1';"
        />
        <div class="card-body">
          <p class="card-text text-dark">
            <b><%= listing.title %></b><br>
            &#x20B9; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>
   