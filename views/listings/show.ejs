<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Listing Details</h3>
  </div>
  
  <div class="card col-6 offset-2 show-card">
   <img 
  src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?v=1') %>" 
  class="card-img-top show-img" 
  alt="listing_image"
  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1625505826533-5c80aca7d157?v=1';"
/>
    <div class="card-body">
      <p class="card-text">
        <b><%= listing.title %></b> <br />
        <%= listing.description %> <br />
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <br />
        <%= listing.location %> <br />
        <%= listing.country %>
      </p>
    </div>
  </div>

  <br />

  <div class="btns">
    <a 
      href="/listings/<%= listing._id %>/edit" 
      class="btn btn-dark col-1 offset-2 edit-btn"
    >Edit</a>

    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>
</div>